{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Bootloader",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/bootloader/bootloader.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/${command:raspberry-pi-pico.getTarget}.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "monitor reset halt",
                "monitor program \"${workspaceFolder}/build/bootloader/bootloader.bin\" 0x10000000",
                "monitor program \"${workspaceFolder}/build/radio/radio_update.bin\" 0x10010000",
                "add-symbol-file ${workspaceFolder}/build/radio/radio.elf 0x10010000"
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
        {
            "name": "Debug Radio",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceFolder}/build/radio/radio.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "gdbPath": "${command:raspberry-pi-pico.getGDBPath}",
            "device": "${command:raspberry-pi-pico.getChipUppercase}",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/${command:raspberry-pi-pico.getTarget}.cfg"
            ],
            "svdFile": "${userHome}/.pico-sdk/sdk/2.3.0/src/${command:raspberry-pi-pico.getChip}/hardware_regs/${command:raspberry-pi-pico.getChipUppercase}.svd",
            "runToEntryPoint": "main",
            "overrideLaunchCommands": [
                "monitor reset halt",
                "monitor program \"${workspaceFolder}/build/radio/radio_update.bin\" 0x10010000",
            ],
            "openOCDLaunchCommands": [
                "adapter speed 5000"
            ]
        },
    ]
}
